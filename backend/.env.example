# Port the backend listens on.
PORT=3001

# Origin allowed to call the API (CORS). Must match the frontend's dev/prod URL.
FRONTEND_ORIGIN=http://localhost:5173

# --- Admin area (/admin) ---
# Single shared admin password, compared server-side with a timing-safe
# check. Never sent to the frontend — pick something you wouldn't reuse
# elsewhere, since it lives in plaintext in this env var.
ADMIN_PASSWORD=

# Random secret used to HMAC-sign the admin session cookie. Generate with:
#   openssl rand -hex 32
# Separate from ADMIN_PASSWORD so rotating it invalidates all sessions
# without having to change the login password.
ADMIN_SESSION_SECRET=

# Read/write token for Vercel Blob (pricing/photo overrides + prod contact
# log). Locally: run `vercel env pull` after connecting a Blob store to the
# project in the Vercel dashboard, or copy the value from
# Project Settings -> Storage there. In production, Vercel injects this
# automatically once a Blob store is connected — nothing to set manually.
BLOB_READ_WRITE_TOKEN=

# --- Email notifications ---
# Resend API key (free tier: 3,000 emails/month, 100/day, no card needed).
# Get one at https://resend.com/api-keys after signing up. Every contact-form
# submission is logged first regardless of this — without a key set, the
# route just skips sending and logs a warning, so local dev works with no
# key at all. Sends from the shared resend.dev test address, which only
# delivers to the email that owns the Resend account, so sign up with the
# same address the site should receive submissions at
# (krutkev00@gmail.com by default, or whatever's set in /admin -> Контакти).
RESEND_API_KEY=
